# ---- Server ----
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# SQLite database file location
DATABASE_PATH=./data/icloud-hme.sqlite

# Master key used to derive the AES-256-GCM key that encrypts sensitive
# columns (iCloud passwords, session cookies, IMAP passwords, API-key material).
# MUST be set in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_MASTER_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Local-only mode: set true to disable API-key auth entirely (no key required).
# The Electron desktop app sets this automatically.
DISABLE_AUTH=false

# Default Apple iCloud web client identifiers (rarely need changing).
ICLOUD_CLIENT_BUILD_NUMBER=2413Project28
ICLOUD_CLIENT_MASTERING_NUMBER=2413B28

# Fallback portal for the headless cookie-refresh browser when an account's
# webservice URL hasn't been discovered yet. Use https://www.icloud.com/ for
# international Apple IDs.
ICLOUD_LOGIN_URL=https://www.icloud.com.cn/

# ---- Browser (Playwright) ----
# Login itself is done via SRP (no browser). Playwright is only used for the
# cookie-refresh fast path and "打开网页" (opening a signed-in Apple page).
# Chromium channel launched for those. Defaults to the system browser (no
# download): "msedge" on Windows, "chrome" (Google Chrome) on macOS.
# Alternative: "chromium" after `npx playwright install chromium`.
# Leave empty to use the platform default.
PLAYWRIGHT_CHANNEL=
# Persistent browser profiles (one dir per account).
PROFILES_DIR=./data/profiles
# Session keeper: every N minutes each account's session is refreshed (cookie
# fast path, falling back to a silent password+trust-token SRP relogin) so
# sessions stay alive instead of expiring. 0 disables.
SESSION_REFRESH_MINUTES=180

# Mark scanner: every N minutes inboxes are scanned and alias mark rules
# (已注册/已开通…) are applied automatically. 0 disables.
MARK_SCAN_MINUTES=30

# ---- Web (Vite) ----
# Base URL the web console uses to reach the API.
VITE_API_BASE_URL=http://localhost:8787
